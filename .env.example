# ==============================================================================
# SignalSafe Campus — Environment Variables Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit .env containing production secrets to version control.
# ==============================================================================

# --- Dedicated SignalSafe PostgreSQL Configuration ---
# Container & Service settings
SIGNALSAFE_DB_NAME=signalsafe_db
SIGNALSAFE_DB_USER=signalsafe_user
SIGNALSAFE_DB_PASSWORD=your_strong_password_here_min_16_chars
SIGNALSAFE_DB_HOST=127.0.0.1
SIGNALSAFE_DB_PORT=5434

# Full SQLAlchemy Connection URL
# For local Python backend connecting to host-published Docker port:
SIGNALSAFE_DATABASE_URL=postgresql://signalsafe_user:your_strong_password_here_min_16_chars@127.0.0.1:5434/signalsafe_db

# For backend running inside Docker on signalsafe_network (if containerized in future):
# SIGNALSAFE_DATABASE_URL=postgresql://signalsafe_user:your_strong_password_here_min_16_chars@signalsafe_postgres:5432/signalsafe_db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- SignalSafe Session & Security ---
SIGNALSAFE_SECRET_KEY=change_this_to_a_random_cryptographic_secret_key_32_bytes
SIGNALSAFE_TOKEN_EXPIRY_HOURS=12

# --- JCER ERP Authentication Integration ---
# Trusted JCER ERP Base URL for user validation
JCER_ERP_AUTH_URL=http://localhost:5000/api/auth

# --- Application Server ---
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
